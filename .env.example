BRIDGE_PROJECT_ID=mu-rnd-5.2
BRIDGE_ROOT=C:\Users\YOUR_USER\Desktop\MU-RND-5.2

# Optional multi-project map. When set, it overrides BRIDGE_PROJECT_ID/BRIDGE_ROOT.
# BRIDGE_PROJECTS_JSON={"mu-rnd-5.2":"C:\\Users\\YOUR_USER\\Desktop\\MU-RND-5.2","arkania":"D:\\Projects\\ArkaniaWeb"}

# Local REST debug token. INSTALL AND START.cmd generates a random value automatically.
BRIDGE_TOKEN=change-me-local

# Normal filesystem editing is enabled. Destructive/general execution stays disabled.
BRIDGE_ALLOW_WRITE=true
BRIDGE_ALLOW_DELETE=false
BRIDGE_ALLOW_COMMAND=false
BRIDGE_COMMAND_ALLOWLIST=

BRIDGE_MAX_READ_BYTES=4194304
BRIDGE_MAX_TEXT_BYTES=1048576
BRIDGE_MAX_COMMAND_SECONDS=120
BRIDGE_MAX_COMMAND_OUTPUT_BYTES=524288
BRIDGE_AUDIT_LOG=bridge-audit.log
