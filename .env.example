# Project exposed to ChatGPT through the local read-only MCP server.
BRIDGE_PROJECT_ID=ssemu
BRIDGE_ROOT=C:\Users\hatim\Desktop\SSEMU-2.5.9

# Optional multi-project map. When set, it overrides BRIDGE_PROJECT_ID/BRIDGE_ROOT.
# BRIDGE_PROJECTS_JSON={"ssemu":"C:\\Users\\hatim\\Desktop\\SSEMU-2.5.9","arkania":"D:\\Projects\\ArkaniaWeb"}

# Protects only the local REST debug endpoints.
# The MCP endpoint stays loopback-only and is reached through Secure MCP Tunnel.
BRIDGE_TOKEN=change-me-local

BRIDGE_MAX_READ_BYTES=4194304
BRIDGE_MAX_TEXT_BYTES=1048576
BRIDGE_AUDIT_LOG=bridge-audit.log
